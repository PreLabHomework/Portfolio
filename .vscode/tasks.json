{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cl.exe build active file",
            "type": "shell",
            "command": "\"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cl.exe /EHsc /Zi /Fe:\"${fileDirname}\\${fileBasenameNoExtension}.exe\" \"${file}\"",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles the active C++ file with MSVC (cl.exe)"
        }
    ]
}
